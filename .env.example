# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public port that Nginx listens on (http://localhost:<PUBLIC_PORT>)
PUBLIC_PORT=8080

# --- URLs --------------------------------------------------------------------
# Public origin of the app. Both frontend and backend are served from here
# through Nginx, so they share the same origin.
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# --- Database ----------------------------------------------------------------
POSTGRES_DB=stockmonitor
POSTGRES_USER=stockmonitor
POSTGRES_PASSWORD=
# Used by the backend. Inside Docker the host is the service name `postgres`.
DATABASE_URL=postgresql://stockmonitor:@postgres:5432/stockmonitor

# --- Finnhub: quotes, search, company profiles -------------------------------
# https://finnhub.io/dashboard  (server-side only, never exposed to the browser)
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_TIMEOUT_MS=8000

# --- Twelve Data: historical candles (charts) --------------------------------
# https://twelvedata.com/account/api-keys
# Finnhub gates historical candles behind a paid plan, so charts use Twelve Data.
# Free plan: 8 requests/minute, 800/day.
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com
TWELVEDATA_TIMEOUT_MS=10000

# Request pre-market / after-hours bars on intraday charts. Needs a Twelve Data
# plan that includes extended hours (Pro and above), and the provider only serves
# them for intervals of 30 minutes or less. Left on, a rejection makes the app
# fall back to regular-session bars automatically.
TWELVEDATA_PREPOST=false

# Which provider serves charts: auto | twelvedata | finnhub
# auto prefers Twelve Data when its key is set, and falls back on access errors.
CANDLE_PROVIDER=auto

# --- Google OAuth ------------------------------------------------------------
# Authorised redirect URI must be: <BACKEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT ---------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=sm_token

# --- Paper trading -----------------------------------------------------------
# Practice money. Costs are modelled deliberately: a simulator that fills at the
# mid price for free teaches beginners that trading is free, which it is not.
PAPER_STARTING_CASH=10000
PAPER_COMMISSION=0
# Minimum spread charged, in basis points. The real charge scales up with the
# instrument's own daily range, because that is how spreads behave.
PAPER_SPREAD_BPS=3
PAPER_MAX_ORDER_VALUE=1000000

# --- Notifications -----------------------------------------------------------
NOTIFY_ENABLED=true
NOTIFY_CRON=* * * * *
NOTIFY_MAX_ATTEMPTS=4
NOTIFY_BATCH_SIZE=50
# Email is disabled cleanly when SMTP_URL is empty; webhooks always work.
# Example: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Stackr <alerts@localhost>

# --- Poller ------------------------------------------------------------------
# node-cron expression. Default: every 5 minutes, to stay well inside the
# provider's free-tier request quota.
POLL_CRON=*/5 * * * *
POLL_ENABLED=true
POLL_CONCURRENCY=4
# Nothing trades overnight, at weekends or on exchange holidays, so a cycle then
# would spend provider quota re-reading an unchanged price.
POLL_SKIP_WHEN_CLOSED=true
