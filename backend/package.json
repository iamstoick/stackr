{
  "name": "stackr-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the Finnhub stock monitoring app",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "1.19.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "node-cron": "4.6.0",
    "nodemailer": "9.0.5",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "supertest": "7.2.2",
    "vitest": "4.1.11"
  }
}
